# Veriflow build/test output
.tmp/
dist/
build/
coverage.out
*.coverprofile

# Root-level local binaries only.
# Leading slashes are intentional: unanchored names such as `veriflow`
# would also ignore source directories like cmd/veriflow/.
/veriflow
/veriflow.exe
/example-api
/example-api.exe
/read-into-clipboard
/read-into-clipboard.exe

# Generated example artifacts
examples/project/artifacts/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx

# Editors / OS
.DS_Store
.idea/
.vscode/
